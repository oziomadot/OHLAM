{
  "name": "ohlam",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "postinstall": "patch-package",
    "prebuild": "expo prebuild --clean",
    "build:android": "expo prebuild --clean && expo build:android",
    "build:ios": "expo prebuild --clean && expo build:ios"
  },
  "jest": {
    "preset": "jest-expo",
    "testPathIgnorePatterns": [
      "<rootDir>/e2e/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleNameMapper": {
      "^@/config(.*)$": "<rootDir>/src/config$1",
      "^@/context/(.*)$": "<rootDir>/context/$1",
      "^@/components/(.*)$": "<rootDir>/src/components/$1",
      "^@/(.*)$": "<rootDir>/app/$1",
      "^components/(.*)$": "<rootDir>/components/$1"
    }
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.7",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-picker/picker": "2.11.4",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.3.16",
    "axios": "^1.12.2",
    "currency-formatter": "^1.5.9",
    "d3-shape": "^3.2.0",
    "expo": "^57.0.8",
    "expo-application": "~57.0.2",
    "expo-asset": "^57.0.7",
    "expo-audio": "~57.0.3",
    "expo-blur": "~57.0.2",
    "expo-build-properties": "~57.0.7",
    "expo-camera": "~57.0.3",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "^57.0.7",
    "expo-crypto": "~57.0.1",
    "expo-dev-client": "^57.0.9",
    "expo-device": "~57.0.1",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.1",
    "expo-image-picker": "~57.0.6",
    "expo-intent-launcher": "~57.0.1",
    "expo-linking": "^57.0.4",
    "expo-local-authentication": "~57.0.2",
    "expo-location": "~57.0.6",
    "expo-notifications": "^57.0.7",
    "expo-router": "^57.0.8",
    "expo-screen-capture": "~57.0.1",
    "expo-secure-store": "~57.0.1",
    "expo-sharing": "~57.0.7",
