  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@react-native-community/cli": "^20.0.2",
    "@tailwindcss/postcss": "^4.1.15",
    "@types/react": "~19.2.0",
    "patch-package": "^8.0.1",
    "postcss": "^8.5.6",
    "postinstall-postinstall": "^2.1.0",
    "prettier": "^3.6.2",
    "react-test-renderer": "19.2.3",
    "tailwindcss": "^4.1.15",
    "typescript": "~6.0.3"
  },
